import seaborn as sns

df = sns.load_dataset("tips")
df["tip_pct"] = (df["tip"] / df["total_bill"]) * 100

over_100 = df[df["tip_pct"] > 100]

print("Min tip_pct:", df["tip_pct"].min())
print("Max tip_pct:", df["tip_pct"].max())
print("Count of values > 100:", len(over_100))
print("\nRows with tip_pct > 100:")
print(over_100[["total_bill", "tip", "tip_pct"]])

# One-Sentence Explanation:
# Tip percentages greater than 100% can signal data quality issues such as decimal or unit typos, swapped or misrecorded bill and tip amounts, or extreme outliers that can distort model training and summary statistics.


